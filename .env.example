# ==============================================================================
# SmartExpense AI — Environment Variables
# ==============================================================================

# GEMINI_API_KEY: Required for server-side Gemini 3.8 Flash API features
# (Transaction category auto-suggestion, grounded financial chat copilot, multimodal receipt scanner).
# In Google AI Studio, this is automatically injected at runtime from user secrets.
# If hosting the backend on Google Cloud Run or a VPS, set this secret in your environment.
GEMINI_API_KEY=""

# PORT: Server listening port (default: 3000)
PORT=3000

# VITE_BASE_PATH: Base path for static assets when building for GitHub Pages
# Example: "/smartexpense-ai/" or "./" (default: "./")
VITE_BASE_PATH="./"

# APP_URL: The public URL where this applet or backend is hosted
APP_URL="http://localhost:3000"

# SUPABASE CONFIGURATION: Required for Supabase Cloud Auth & PostgreSQL DB
# In production or local dev, obtain these from your Supabase Project Settings > API.
# Note: VITE_SUPABASE_ANON_KEY is the public browser key with Row-Level Security (RLS) enforcement.
# NEVER put your service_role secret here.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
